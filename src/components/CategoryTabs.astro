---
interface Props {
  active?: 'frontend' | 'web3' | 'remote' | 'all';
}
const { active = 'all' } = Astro.props;

const tabs = [
  { id: 'all', label: '全部', href: '/questions' },
  { id: 'frontend', label: '前端', href: '/questions?category=frontend' },
  { id: 'web3', label: 'Web3', href: '/questions?category=web3' },
  { id: 'remote', label: '远程', href: '/questions?category=remote' },
] as const;
---

<nav aria-label="分类筛选" class="mb-6">
  <ul
    class="flex flex-wrap items-center gap-1 rounded-2xl border border-slate-200 bg-white p-1 text-sm shadow-sm dark:border-slate-800 dark:bg-slate-900"
  >
    {
      tabs.map((tab) => (
        <li>
          <a
            href={tab.href}
            aria-current={active === tab.id ? 'page' : undefined}
            class:list={[
              'inline-flex items-center rounded-xl px-4 py-2 font-medium transition',
              active === tab.id
                ? 'bg-indigo-600 text-white shadow-sm'
                : 'text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800',
            ]}
          >
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
