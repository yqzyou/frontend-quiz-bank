---
const year = new Date().getFullYear();
---

<footer
  class="mt-16 border-t border-slate-200/60 py-8 text-sm text-slate-600 dark:border-slate-800/60 dark:text-slate-400"
>
  <div
    class="mx-auto flex w-full max-w-5xl flex-col items-start justify-between gap-4 px-4 sm:flex-row sm:items-center sm:px-6 lg:px-8"
  >
    <div>
      <p class="font-medium text-slate-900 dark:text-slate-100">前端题库 · Frontend Quiz Bank</p>
      <p class="mt-1">MIT Licensed · 内容遵循 CC-BY-SA 4.0</p>
    </div>
    <div class="flex items-center gap-4">
      <a
        href="https://github.com/yqzyou/frontend-quiz-bank"
        rel="noopener noreferrer"
        target="_blank"
        class="rounded-lg border border-slate-300 px-3 py-1.5 text-slate-700 transition hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
      >
        GitHub
      </a>
      <span class="text-xs text-slate-500 dark:text-slate-500">© {year}</span>
    </div>
  </div>
</footer>
