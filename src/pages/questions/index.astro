---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuestionExplorer from '../../components/islands/QuestionExplorer.tsx';
import { loadAllQuestions } from '@lib/content-loader';

const url = Astro.url;
const initialCategory = url.searchParams.get('category') ?? 'all';
const initialStatus = url.searchParams.get('status') ?? 'all';
const initialWeek = url.searchParams.get('week') ?? 'all';
const initialSearch = url.searchParams.get('q') ?? '';

const all = loadAllQuestions();

// 序列化为岛屿可消费的轻量结构（不含 explanation / references 等大块文本）
const explorerQuestions = all.map((q) => ({
  slug: q.slug,
  title: q.frontmatter.title,
  question: q.question,
  category: q.frontmatter.category,
  sub_category: q.frontmatter.sub_category,
  week: q.frontmatter.week,
  status: q.frontmatter.status,
  difficulty: q.frontmatter.difficulty,
  type: q.frontmatter.type,
  tags: q.frontmatter.tags,
}));

const reviewedCount = all.filter((q) => q.frontmatter.status === 'reviewed').length;
const draftCount = all.filter((q) => q.frontmatter.status === 'draft').length;
---

<BaseLayout
  title="题库 · 前端题库"
  description={`共 ${all.length} 道高质量前端 / Web3 / 远程协作题目（已审校 ${reviewedCount} · 草稿 ${draftCount}），按方向、状态、周次筛选，关键词即时搜索。配套解析、参考链接、SM-2 间隔复习。`}
  breadcrumb={[
    { name: '首页', url: '/' },
    { name: '题库', url: '/questions' },
  ]}
>
  <section class="py-4">
    <header class="mb-6">
      <nav aria-label="面包屑" class="mb-3 text-sm text-slate-500 dark:text-slate-400">
        <a href="/" class="hover:underline">首页</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-slate-700 dark:text-slate-300">题库</span>
      </nav>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">题库</h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        共 {all.length} 道题 · 已审校 {reviewedCount} · 草稿 {draftCount} · 关键词搜索 + 即时筛选
      </p>
    </header>

    <QuestionExplorer
      client:load
      questions={explorerQuestions}
      initialCategory={initialCategory}
      initialStatus={initialStatus}
      initialWeek={initialWeek}
      initialSearch={initialSearch}
    />
  </section>
</BaseLayout>
