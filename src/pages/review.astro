---
import BaseLayout from '../layouts/BaseLayout.astro';
import Dashboard from '../components/islands/Dashboard.tsx';
import ReviewQueue from '../components/islands/ReviewQueue.tsx';
import { loadAllQuestions } from '@lib/content-loader';

const all = loadAllQuestions();
const total = all.length;
const reviewed = all.filter((q) => q.frontmatter.status === 'reviewed').length;
const draft = all.filter((q) => q.frontmatter.status === 'draft').length;
---

<BaseLayout title="复习中心 · 前端题库" description="基于 SM-2 间隔复习算法的今日待办与学习统计。">
  <nav aria-label="面包屑" class="mb-4 text-sm text-slate-500 dark:text-slate-400">
    <a href="/" class="hover:underline">首页</a>
    <span class="mx-2" aria-hidden="true">/</span>
    <span class="text-slate-700 dark:text-slate-300">复习中心</span>
  </nav>

  <header class="mb-6">
    <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white">复习中心</h1>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      SM-2 间隔复习 · 共 {total} 道题（已审校 {reviewed} · 草稿 {draft}）· 进度本地保存，不上传服务器
    </p>
  </header>

  <div class="mb-6">
    <Dashboard client:load />
  </div>

  <ReviewQueue client:load allSlugs={all.map((q) => q.slug)} />
</BaseLayout>
